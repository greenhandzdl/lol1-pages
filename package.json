{
  "name": "lol1-pages",
  "version": "1.0.0",
  "private": true,
  "description": "lol1.moe · 萝莉图鉴 —— 纯静态站点（3D 模型流水线为离线开发依赖）",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8788",
    "model": "node scripts/3d/prepare-model.mjs",
    "model:strip": "node scripts/3d/strip-texture.mjs",
    "img": "node scripts/img/build-srcset.mjs",
    "pages": "node scripts/build-pages.mjs",
    "check:data": "node scripts/check-data.mjs",
    "test": "./tests/run.sh",
    "test:fast": "./tests/run.sh tests/test_pages.py tests/test_data.py",
    "test:data": "./tests/run.sh tests/test_data.py tests/test_crosscheck.py"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1"
  },
  "dependencies": {
    "meshoptimizer": "^0.22.0"
  }
}
